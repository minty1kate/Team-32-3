--- !u!114 &334456406
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 334456404}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9011fcb8b9f99df488c1978f66e888e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KitchenIntroTrigger
  introLines:
  - "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u0442\u0432\u0430\u0440\u044C?..
    \u041E\u043D\u0430 \u0441\u0442\u043E\u0438\u0442 \u0441\u043F\u0438\u043D\u043E\u0439
    \u043A\u043E \u043C\u043D\u0435, \u043D\u043E \u044D\u0442\u043E\u0442 \u0441\u0438\u043B\u0443\u044D\u0442..."
  - "\u0413\u043E\u0441\u043F\u043E\u0434\u0438, \u043E\u043D \u0442\u0430\u043A
    \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u043C\u043E\u044E \u043C\u0430\u0442\u044C.
    \u0422\u0435 \u0436\u0435 \u043F\u043B\u0435\u0447\u0438, \u0442\u0430 \u0436\u0435
    \u043E\u0441\u0430\u043D\u043A\u0430, \u043D\u043E \u0432\u0441\u0451 \u0438\u0437\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435,
    \u0447\u0443\u0436\u043E\u0435."
  - "\u041E\u043D\u0430 \u043F\u0435\u0440\u0435\u0434 \u043F\u043B\u0438\u0442\u043E\u0439
    \u0438 \u043C\u0435\u0448\u0430\u0435\u0442 \u044D\u0442\u0443 \u0435\u0434\u043A\u0443\u044E,
    \u0438\u0441\u043F\u0443\u0441\u043A\u0430\u044E\u0449\u0443\u044E \u0443\u0434\u0443\u0448\u043B\u0438\u0432\u044B\u0439
    \u0441\u043C\u0440\u0430\u0434 \u0433\u0430\u0434\u043E\u0441\u0442\u044C.."
  - "\u041D\u0435\u0442.. \u044D\u0442\u043E \u043D\u0435 \u043E\u043D\u0430. "
  - "\u042D\u0442\u043E \u0433\u043D\u0443\u0441\u043D\u044B\u0439, \u043E\u043C\u0435\u0440\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043C\u043E\u0440\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u0446\u0435\u043F\u0438\u043B
    \u0435\u0451 \u043E\u0431\u043B\u0438\u043A, \u0447\u0442\u043E\u0431\u044B \u0441\u0432\u0435\u0441\u0442\u0438
    \u043C\u0435\u043D\u044F \u0441 \u0443\u043C\u0430. "
  - "\u042F \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044E \u044D\u0442\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E
    \u0437\u0430\u0445\u043B\u0435\u0431\u043D\u0443\u0442\u044C\u0441\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u044F\u0434\u043E\u043C"
