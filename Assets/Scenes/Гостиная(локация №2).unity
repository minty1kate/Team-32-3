  m_Script: {fileID: 11500000, guid: e67f47bbbe0733b448ce031482280b58, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LivingRoomCutscene
  dialogueManager: {fileID: 1174992060}
  livingRoomLines:
  - "\u041A\u0442\u043E \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u0432 \u043A\u0430\u043F\u044E\u0448\u043E\u043D\u0435?! \u041E\u043D \u0441\u043E\u0432\u0441\u0435\u043C
    \u043D\u0435 \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u043C\u043E\u0435\u0433\u043E
    \u0431\u0440\u0430\u0442\u0430.."
  - " \u0427\u0442\u043E \u0437\u0430 \u0443\u0436\u0430\u0441\u043D\u044B\u0439
    \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442 \u043F\u0440\u043E\u0431\u0440\u0430\u043B\u0441\u044F
    \u0432 \u043C\u043E\u0439 \u0434\u043E\u043C... \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043E\u0441\u043A\u0432\u0435\u0440\u043D\u0438\u0442\u044C \u043C\u043E\u0439
    \u0434\u043E\u043C!"
  - "\u0415\u0433\u043E \u0431\u043E\u0440\u043C\u043E\u0442\u0430\u043D\u0438\u0435...
    \u0437\u043B\u043E\u0432\u0435\u0449\u0435\u0435 \u0448\u0435\u043F\u0442\u0430\u043D\u0438\u0435,
    \u043E\u043D\u0438 \u0434\u0443\u0448\u0430\u0442 \u043C\u0435\u043D\u044F, \u0432\u043E\u0437\u0434\u0443\u0445
    \u0441\u0442\u0430\u043B \u0442\u044F\u0436\u0451\u043B\u044B\u043C, \u043A\u0430\u043A
    \u0432 \u0441\u043A\u043B\u0435\u043F\u0435! \u042F \u043D\u0435 \u043C\u043E\u0433\u0443
    \u044D\u0442\u043E \u0441\u043B\u0443\u0448\u0430\u0442\u044C!"
  - "\u041D\u0430\u0434\u043E \u0441\u043E\u0440\u0432\u0430\u0442\u044C \u0435\u0433\u043E
    \u0440\u0438\u0442\u0443\u0430\u043B... \u041E\u0431\u0435\u0441\u0442\u043E\u0447\u0443
    \u043A\u043E\u043C\u043D\u0430\u0442\u0443, \u0432\u044B\u043A\u043B\u044E\u0447\u0443
    \u0441\u0432\u0435\u0442"
