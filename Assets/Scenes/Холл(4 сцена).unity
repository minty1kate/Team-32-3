  m_Script: {fileID: 11500000, guid: a9c3931f9c6e8b5418cfb935cbf21dcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SafePicture
  highlightColor: {r: 0.3915094, g: 0.3915094, b: 0.3915094, a: 1}
  mazeManager: {fileID: 1129862066}
  dialogueManager: {fileID: 1140842123}
  safeLines:
  - "\u041E\u0433\u043E... \u041D\u0435 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
    \u0437\u0430 \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u0439
    \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0442\u0430\u0439\u043D\u043E\u0439
    \u0441\u0435\u0439\u0444. \u0427\u0442\u043E \u0436\u0435 \u0442\u0430\u043A\u043E\u0433\u043E
    \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u043E
    \u0437\u0434\u0435\u0441\u044C \u043F\u0440\u044F\u0442\u0430\u0442\u044C?"
  - "\u0418 \u043A\u0430\u043A \u043C\u043D\u0435 \u0435\u0433\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C?..
    \u041F\u043E\u0445\u043E\u0436\u0435, \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
    \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u043B\u043E, \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437
    \u044D\u0442\u0443 \u0437\u0430\u0449\u0438\u0442\u0443."
