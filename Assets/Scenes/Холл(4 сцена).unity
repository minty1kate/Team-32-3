  deathSound: {fileID: 8300000, guid: 80aaf942b31a10947a377367a0329e15, type: 3}
  painFlashPanel: {fileID: 0}
  deathDialogueLines:
  - "\u0412\u0441\u0451 \u043A\u043E\u043D\u0447\u0435\u043D\u043E. \u0414\u043E\u043C
    \u0441\u043D\u043E\u0432\u0430 \u043C\u043E\u0439. \u041D\u043E \u044D\u0442\u043E\u0442
    \u0443\u0436\u0430\u0441 \u043D\u0430 \u0435\u0433\u043E \u043B\u0438\u0446\u0435
    \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u043E\u043D
    \u0438\u0441\u0447\u0435\u0437..."
  - "\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u044F \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B \u0443\u0436\u0430\u0441\u043D\u0443\u044E
    \u043E\u0448\u0438\u0431\u043A\u0443?"
  - "\u041D\u0430\u0434\u043E \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F
    \u043E\u0442\u0441\u044E\u0434\u0430..."
  - "\u041A\u0430\u043A \u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u044D\u0442\u0443
    \u0434\u0432\u0435\u0440\u044C \u0432 \u043F\u043E\u0434\u0432\u0430\u043B"
